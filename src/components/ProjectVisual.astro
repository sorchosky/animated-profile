---
import type { ProjectVisual } from '../content/projects';

// Placeholder motion studies, one per project. Swap for video or Lottie when real
// project footage exists; the panel only needs something that fills `.project-visual`.
interface Props { kind: ProjectVisual }
const { kind } = Astro.props;
---
<div class="project-visual" aria-hidden="true">
  {kind === 'conversation' && (
    <svg class="v-conversation" viewBox="0 0 400 320" fill="none">
      <rect class="frame" x="100" y="10" width="200" height="300" rx="28" />
      <rect class="bubble b1 guest" x="170" y="56" width="110" height="34" rx="17" />
      <rect class="bubble b2" x="120" y="102" width="140" height="58" rx="17" />
      <rect class="bubble b3 guest" x="190" y="172" width="90" height="34" rx="17" />
      <g class="bubble b4 typing">
        <rect x="120" y="218" width="64" height="34" rx="17" />
        <circle cx="140" cy="235" r="4" /><circle cx="152" cy="235" r="4" /><circle cx="164" cy="235" r="4" />
      </g>
      <rect class="field" x="120" y="270" width="160" height="24" rx="12" />
    </svg>
  )}
  {kind === 'wayfinding' && (
    <svg class="v-wayfinding" viewBox="0 0 400 320" fill="none">
      {[0, 1, 2, 3].map(i => <rect class="aisle" x={60 + i * 80} y="40" width="40" height="200" rx="6" />)}
      <path class="route" d="M30 290 H130 V60 H210 V200 H290 V110" pathLength="1" />
      <circle class="pin-pulse" cx="290" cy="110" r="10" />
      <circle class="pin" cx="290" cy="110" r="7" />
    </svg>
  )}
  {kind === 'access' && (
    <svg class="v-access" viewBox="0 0 400 320" fill="none">
      <rect class="door" x="120" y="20" width="160" height="280" rx="6" />
      <rect class="panel-inset" x="140" y="44" width="120" height="100" rx="4" />
      <rect class="panel-inset" x="140" y="164" width="120" height="112" rx="4" />
      <circle class="ring" cx="244" cy="160" r="16" pathLength="1" />
      <circle class="core" cx="244" cy="160" r="5" />
    </svg>
  )}
  {kind === 'telemetry' && (
    <svg class="v-telemetry" viewBox="0 0 400 320" fill="none">
      {[0, 1, 2, 3].map(i => <line class="grid" x1="30" x2="370" y1={60 + i * 60} y2={60 + i * 60} />)}
      <path class="threshold" d="M30 110 H370" />
      <path class="trace" d="M30 230 L80 210 L130 220 L180 170 L230 185 L280 120 L330 100 L370 70" pathLength="1" />
      <circle class="alert" cx="330" cy="100" r="7" />
      {[0, 1, 2, 3, 4].map(i => <rect class="bar" x={40 + i * 68} y="268" width="48" height="24" rx="3" style={`--i:${i}`} />)}
    </svg>
  )}
</div>

<style>
  svg { --ink: var(--color-text); --accent: var(--color-action-primary); --soft: rgb(243 230 208 / 16%); overflow: visible; }

  /* Conversation: messages land in sequence, then the assistant types. */
  .frame { stroke: var(--soft); stroke-width: 2; }
  .bubble { fill: var(--soft); opacity: 0; animation: bubble-in 6s var(--ease-out) infinite; transform-box: fill-box; transform-origin: 0 100%; }
  .bubble.guest { fill: var(--accent); transform-origin: 100% 100%; }
  .b2 { animation-delay: 0.6s; } .b3 { animation-delay: 1.4s; } .b4 { animation-delay: 2s; }
  .typing rect { fill: var(--soft); }
  .typing circle { fill: var(--ink); animation: typing 1s ease-in-out infinite; }
  .typing circle:nth-of-type(2) { animation-delay: 0.15s; } .typing circle:nth-of-type(3) { animation-delay: 0.3s; }
  .field { stroke: var(--soft); stroke-width: 2; }
  @keyframes bubble-in {
    0% { opacity: 0; transform: translateY(8px) scale(0.92); }
    8%, 85% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: none; }
  }
  @keyframes typing { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

  /* Wayfinding: a route draws through the aisles to a pulsing pin. */
  .aisle { fill: var(--soft); }
  .route { stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 4s var(--ease-out) infinite; }
  .pin { fill: var(--accent); stroke: var(--ink); stroke-width: 2; }
  .pin-pulse { fill: var(--accent); transform-box: fill-box; transform-origin: center; animation: pulse 2s ease-out infinite; }
  @keyframes draw { 0% { stroke-dashoffset: 1; } 60%, 90% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes pulse { from { transform: scale(1); opacity: 0.6; } to { transform: scale(3); opacity: 0; } }

  /* Access: the lock ring completes, then the core turns to the accent color. */
  .door { stroke: var(--ink); stroke-width: 2; }
  .panel-inset { stroke: var(--soft); stroke-width: 2; }
  .ring { stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transform-box: fill-box; transform-origin: center; transform: rotate(-90deg); animation: draw 3.5s var(--ease-out) infinite; }
  .core { fill: var(--soft); animation: unlock 3.5s ease infinite; }
  @keyframes unlock { 0%, 55% { fill: var(--soft); } 65%, 90% { fill: var(--accent); } 100% { fill: var(--soft); } }

  /* Telemetry: the trace draws past a threshold and an alert fires. */
  .grid { stroke: var(--soft); stroke-width: 1; }
  .threshold { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 6 6; }
  .trace { stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 5s linear infinite; }
  .alert { fill: var(--accent); opacity: 0; transform-box: fill-box; transform-origin: center; animation: alert 5s ease-out infinite; }
  .bar { fill: var(--soft); transform-box: fill-box; transform-origin: 0 50%; animation: bar 2.4s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -0.4s); }
  @keyframes alert { 0%, 50% { opacity: 0; transform: scale(0.5); } 56%, 88% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes bar { from { transform: scaleX(0.35); } to { transform: scaleX(1); } }

  /* Reduced motion shows each study's resolved state. */
  @media (prefers-reduced-motion: reduce) {
    .bubble, .alert { opacity: 1; }
    .route, .ring, .trace { stroke-dashoffset: 0; }
    .pin-pulse { opacity: 0; }
    .core { fill: var(--accent); }
  }
</style>
